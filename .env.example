ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://canchariane:canchariane_password@localhost:5432/canchariane_db
SYNC_DATABASE_URL=postgresql+psycopg://canchariane:canchariane_password@localhost:5432/canchariane_db

# Security & Tokens
JWT_SECRET=canchariane_super_secret_key_minimum_32_bytes_secure_token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Business Defaults
DEFAULT_TIMEZONE=America/Bogota
HOLD_EXPIRATION_MINUTES=10
MIN_LEAD_TIME_MINUTES=30
